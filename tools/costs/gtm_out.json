  {
   "id": "pro",
   "name": "Freemium + Ruta Pro subscription",
   "pitch": "Lessons, drills and reading stay free; Pro unlocks unlimited Profe conversations and grading, full mock exams and offline audio.",
   "price": "$9.99 a month or $69.99 a year (about 17% under Duolingo Super and 35% under Babbel's yearly plans)",
   "who": "Self-study learners worldwide; the default channel (Google Play).",
   "fee": 0.15,
   "arppu_month": 7.1,
   "arppu_note": "Assumes 70% choose yearly ($5.83 a month) and 30% monthly ($9.99).",
   "pros": [
    "Standard for the category, learners know it",
    "Recurring revenue",
    "Store handles payments, refunds and tax"
   ],
   "cons": [
    "Needs many users: conversion is single-digit",
    "Competes head-on with Duolingo and Babbel"
   ]
  },
  {
   "id": "pass",
   "name": "DELE Exam Pass (one-off)",
   "pitch": "3 months of everything, built around one exam date: full mock exams with timing, graded writing and speaking, a study plan to the day.",
   "price": "$29.99 once (well under 25% of the exam fee itself)",
   "who": "Candidates registered for a DELE session; peaks before the registration deadlines.",
   "fee": 0.2,
   "price_once": 29.99,
   "buy_share": 0.03,
   "pros": [
    "Clear promise and deadline, easy to sell",
    "Fits people who won't subscribe",
    "Marketable to exam centres"
   ],
   "cons": [
    "Seasonal revenue",
    "One-off: no recurring income unless they move up a level"
   ]
  },
  {
   "id": "b2b",
   "name": "Schools, academies and exam centres (B2B licence)",
   "pitch": "Seats for language schools, universities and DELE exam centres, with the coverage dashboard as a teacher tool and class progress reports.",
   "price": "$25 per student per year (minimum 30 seats), invoiced directly",
   "who": "Instituto Cervantes-accredited centres, academies, universities, companies with Spanish-learning staff (Panama: Canal, logistics, tourism).",
   "fee": 0.03,
   "seat_year": 25,
   "accounts": {
    "soft": 0,
    "launch": 3,
    "growth": 12,
    "mature": 30
   },
   "seats_per_account": 60,
   "pros": [
    "Higher, predictable contracts",
    "No ad spend per user",
    "The curriculum dashboard is a real differentiator"
   ],
   "cons": [
    "Slow sales cycle",
    "Needs teacher accounts, invoicing and support"
   ]
  },
  {
   "id": "local",
   "name": "Regional pricing for Panama and Latin America",
   "pitch": "The same Pro at a local price, marketed with Casco Viejo content, Panamanian Spanish and partnerships with schools and employers.",
   "price": "$3.99 a month or $29.99 a year",
   "who": "Learners in Panama and the region; expats; tourism and hospitality staff.",
   "fee": 0.15,
